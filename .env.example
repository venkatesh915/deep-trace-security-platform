# ==============================================================================
# DEEP TRACE CYBERNETICS — FULL-STACK SECURITY PLATFORM CONFIGURATION
# ==============================================================================

# Backend Port
PORT=5000

# Hosted PostgreSQL connection string (e.g. Supabase, Neon, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Secret Key (Use a cryptographically secure random string of 32+ characters)
JWT_SECRET="deep-trace-cybernetics-super-secret-jwt-key-2026-production"

# JWT Expiration Duration
JWT_EXPIRES_IN="1h"

# Frontend Origin URL (for backend CORS policy)
FRONTEND_URL="http://localhost:5173"

# Frontend API Base URL
VITE_API_URL="http://localhost:5000/api"
